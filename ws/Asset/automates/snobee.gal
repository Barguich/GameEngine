SnoBee(Patrol){

  * (Patrol)
  | Closest(@,5) ? :(Hunt)
  | Step(F,K) ? Hit(F) :(Patrol)
  | Step(F,V) ? 80%Move(F) / 10%Turn(L) / 10%Turn(R) :(Patrol)
  | Step(L,V) ? Turn(L) :(Patrol)
  | Step(R,V) ? Turn(R) :(Patrol)
  | True ? Turn(B) :(Patrol)

  * (Hunt)
  | !Closest(@,7) ? :(Patrol)
  | Closest(@,N) & Step(N,K) ? Hit(N) :(Hunt)
  | Closest(@,N) & Step(N,V) ? Move(N) :(Hunt)
  | Closest(@,S) & Step(S,K) ? Hit(S) :(Hunt)
  | Closest(@,S) & Step(S,V) ? Move(S) :(Hunt)
  | Closest(@,E) & Step(E,K) ? Hit(E) :(Hunt)
  | Closest(@,E) & Step(E,V) ? Move(E) :(Hunt)
  | Closest(@,W) & Step(W,K) ? Hit(W) :(Hunt)
  | Closest(@,W) & Step(W,V) ? Move(W) :(Hunt)
  | True ? Turn(B) :(Hunt)
}
