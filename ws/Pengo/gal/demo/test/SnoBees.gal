SnoBee(Patrol){

  * (Patrol)
  | Got(2) ? :(Rage)
  | Closest(@,5) ? :(Hunt)
  | Step(F,K) ? Hit(F) :(Patrol)
  | Step(F,V) ? 80%Move(F) / 10%Turn(L) / 10%Turn(R) :(Patrol)
  | Step(F,O) & Step(L,V) ? Turn(L) :(Patrol)
  | Step(F,O) & Step(R,V) ? Turn(R) :(Patrol)
  | Step(F,O) ? Turn(B) :(Patrol)
  | Step(L,V) ? Turn(L) :(Patrol)
  | Step(R,V) ? Turn(R) :(Patrol)
  | True ? Turn(B) :(Patrol)

  * (Hunt)
  | Got(2) ? :(Rage)
  | !Closest(@,7) ? :(Patrol)
  | Closest(@,N) & Step(N,O) & Step(E,V) ? Move(E) :(Hunt)
  | Closest(@,N) & Step(N,O) & Step(W,V) ? Move(W) :(Hunt)
  | Closest(@,S) & Step(S,O) & Step(W,V) ? Move(W) :(Hunt)
  | Closest(@,S) & Step(S,O) & Step(E,V) ? Move(E) :(Hunt)
  | Closest(@,E) & Step(E,O) & Step(N,V) ? Move(N) :(Hunt)
  | Closest(@,E) & Step(E,O) & Step(S,V) ? Move(S) :(Hunt)
  | Closest(@,W) & Step(W,O) & Step(S,V) ? Move(S) :(Hunt)
  | Closest(@,W) & Step(W,O) & Step(N,V) ? Move(N) :(Hunt)
  | Closest(@,N) & Step(N,@) ? Move(N) :(Hunt)
  | Closest(@,S) & Step(S,@) ? Move(S) :(Hunt)
  | Closest(@,E) & Step(E,@) ? Move(E) :(Hunt)
  | Closest(@,W) & Step(W,@) ? Move(W) :(Hunt)
  | Closest(@,N) & Step(N,K) ? Hit(N) :(Hunt)
  | Closest(@,N) & Step(N,V) ? Move(N) :(Hunt)
  | Closest(@,S) & Step(S,K) ? Hit(S) :(Hunt)
  | Closest(@,S) & Step(S,V) ? Move(S) :(Hunt)
  | Closest(@,E) & Step(E,K) ? Hit(E) :(Hunt)
  | Closest(@,E) & Step(E,V) ? Move(E) :(Hunt)
  | Closest(@,W) & Step(W,K) ? Hit(W) :(Hunt)
  | Closest(@,W) & Step(W,V) ? Move(W) :(Hunt)
  | Step(F,V) ? Move(F) :(Hunt)
  | Step(L,V) ? Turn(L) :(Hunt)
  | Step(R,V) ? Turn(R) :(Hunt)
  | True ? Turn(B) :(Hunt)


  * (Rage)
  | Closest(@,N) & Step(N,O) & Step(E,V) ? Move(E) :(Rage)
  | Closest(@,N) & Step(N,O) & Step(W,V) ? Move(W) :(Rage)
  | Closest(@,S) & Step(S,O) & Step(W,V) ? Move(W) :(Rage)
  | Closest(@,S) & Step(S,O) & Step(E,V) ? Move(E) :(Rage)
  | Closest(@,E) & Step(E,O) & Step(N,V) ? Move(N) :(Rage)
  | Closest(@,E) & Step(E,O) & Step(S,V) ? Move(S) :(Rage)
  | Closest(@,W) & Step(W,O) & Step(S,V) ? Move(S) :(Rage)
  | Closest(@,W) & Step(W,O) & Step(N,V) ? Move(N) :(Rage)
  | Closest(@,N) & Step(N,@) ? Move(N) :(Rage)
  | Closest(@,S) & Step(S,@) ? Move(S) :(Rage)
  | Closest(@,E) & Step(E,@) ? Move(E) :(Rage)
  | Closest(@,W) & Step(W,@) ? Move(W) :(Rage)
  | Closest(@,N) & Step(N,K) ? Hit(N) :(Rage)
  | Closest(@,N) & Step(N,V) ? Move(N) :(Rage)
  | Closest(@,S) & Step(S,K) ? Hit(S) :(Rage)
  | Closest(@,S) & Step(S,V) ? Move(S) :(Rage)
  | Closest(@,E) & Step(E,K) ? Hit(E) :(Rage)
  | Closest(@,E) & Step(E,V) ? Move(E) :(Rage)
  | Closest(@,W) & Step(W,K) ? Hit(W) :(Rage)
  | Closest(@,W) & Step(W,V) ? Move(W) :(Rage)
  | True ? Turn(B) :(Rage)

  * ()
}